+    qptr = Q + (q_start + qpos[:, None]) * Q_STRIDE0 + qhead[:, None] * Q_STRIDE1 + qd[None, :]
+    q0 = gl.load(qptr, mask=qvalid[:, None], other=0.0).to(MMA_DT)
+    q1 = gl.load(qptr + 128, mask=qvalid[:, None], other=0.0).to(MMA_DT)
+    if QK_INT8:
